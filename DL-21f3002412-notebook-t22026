\n            flattened_features,\n            padding=self.padding,\n            max_length=self.max_length,\n            pad_to_multiple_of=self.pad_to_multiple_of,\n            return_tensors=\"pt\",\n        )\n        batch = {k: v.view(batch_size, num_choices, -1) for k, v in batch.items()}\n        if labels is not None:\n            batch[\"labels\"] = torch.tensor(labels, dtype=torch.int64)\n        return batch\n\n\ncollator = DataCollatorForMultipleChoice(tokenizer=tokenizer)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-15T21:19:18.713112Z","iopub.execute_input":"2026-07-15T21:19:18.713447Z","iopub.status.idle":"2026-07-15T21:19:18.723578Z","shell.execute_reply.started":"2026-07-15T21:19:18.713422Z","shell.execute_reply":"2026-07-15T21:19:18.722951Z"}},"outputs":[],"execution_count":14},{"cell_type":"code","source":"# %% ------------------------------------------------------------------\n# 4. MAP@3 metric -- implemented directly from the competition definition\n# ------------------------------------------------------------------\ndef map_at_3(predictions: np.ndarray, labels: np.ndarray) -> float:\n    \"\"\"predictions: (N, 5) logits or probs. labels: (N,) true index 0-4.\"\"\"\n    top3 = np.argsort(-predictions, axis=1)[:, :3]\n    scores = []\n    for pred_row, true_label in zip(top3, labels):\n        if pred_row[0] == true_label:\n            scores.append(1.0)\n        elif pred_row[1] == true_label:\n            scores.append(1.0 / 2)\n        elif pred_row[2] == true_label:\n            scores.append(1.0 / 3)\n        else:\n            scores.append(0.0)\n    return float(np.mean(scores))\n\n\ndef compute_metrics(eval_pred):\n    predictions, labels = eval_pred\n    preds_top1 = predictions.argmax(axis=1)\n    acc = (preds_top1 == labels).mean()\n    return {\"accuracy\": acc, \"map@3\": map_at_3(predictions, labels)}","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-15T21:19:18.724666Z","iopub.execute