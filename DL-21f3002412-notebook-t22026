les):\n    # examples is a dict of column -> list, batched\n    first_sentences = [[p] * 5 for p in examples[\"prompt\"]]\n    second_sentences = [\n        [examples[opt][i] for opt in OPTIONS] for i in range(len(examples[\"prompt\"]))\n    ]\n    # flatten so the tokenizer sees one long list of (prompt, option) pairs\n    first_sentences = sum(first_sentences, [])\n    second_sentences = sum(second_sentences, [])\n\n    tokenized = tokenizer(\n        first_sentences,\n        second_sentences,\n        truncation=True,\n        max_length=MAX_LEN,\n        padding=False,   \n    )\n    # un-flatten back to (num_examples, 5, seq_len)\n    result = {\n        k: [v[i : i + 5] for i in range(0, len(v), 5)] for k, v in tokenized.items()\n    }\n    if \"label\" in examples:\n        result[\"label\"] = examples[\"label\"]\n    return result","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-15T21:19:14.559117Z","iopub.execute_input":"2026-07-15T21:19:14.559558Z","iopub.status.idle":"2026-07-15T21:19:15.282777Z","shell.execute_reply.started":"2026-07-15T21:19:14.559524Z","shell.execute_reply":"2026-07-15T21:19:15.282135Z"}},"outputs":[],"execution_count":12},{"cell_type":"code","source":"from datasets import Dataset\n\ntrain_ds = Dataset.from_pandas(train_data[[\"prompt\", \"A\", \"B\", \"C\", \"D\", \"E\", \"label\"]])\nval_ds = Dataset.from_pandas(val_data[[\"prompt\", \"A\", \"B\", \"C\", \"D\", \"E\", \"label\"]])\ntest_ds = Dataset.from_pandas(test_df[[\"prompt\", \"A\", \"B\", \"C\", \"D\", \"E\"]])\n\ntrain_ds = train_ds.map(preprocess, batched=True, remove_columns=train_ds.column_names)\nval_ds = val_ds.map(preprocess, batched=True, remove_columns=val_ds.column_names)\ntest_ds = test_ds.map(preprocess, batched=True, remove_columns=test_ds.column_names)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-15T21:19:15.284820Z","iopub.execute_input":"2026-07-15T21:19:15.285244Z","iopub.status.idle":"2026-07-15T21:19:18.712018Z"